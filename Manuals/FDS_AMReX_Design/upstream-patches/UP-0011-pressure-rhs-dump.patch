+
+   DO NM=LOWER_MESH_INDEX,UPPER_MESH_INDEX
+      CALL PRESSURE_SOLVER_DUMP(NM,T,DT,.TRUE.)
+   ENDDO
+
    ! Check the residuals of the Poisson solution

    DO NM=LOWER_MESH_INDEX,UPPER_MESH_INDEX
