! ref_loops.f90.in: template of the Fortran reference of the pressure-area loop tests (tests/fds_loops_test.py).
! The lines '!@@<loop id>@@' are replaced by the VERBATIM text of the upstream loop (FireX 36975d7 pres.f90, line ranges pinned and
! hash-checked in fds_loops_gen.py); everything else is data set-up, a minimal stand-in for the FDS types the loop reads, and output.
! The program writes, per case, a stream file of records (inputs, then the outputs of the verbatim loop) read by pb_fds_loops.
! Record: 16-character name, int32 kind (1 integer, 2 real(8)), int32 rank, int32 dims(rank), data (column-major).

MODULE PRECISION_PARAMETERS
IMPLICIT NONE
INTEGER, PARAMETER :: EB = KIND(1.0D0)
REAL(EB), PARAMETER :: TWENTY_EPSILON_EB=20._EB*EPSILON(1._EB)
END MODULE PRECISION_PARAMETERS

MODULE GLOBAL_CONSTANTS
IMPLICIT NONE
INTEGER, PARAMETER :: NULL_BOUNDARY=0, SOLID_BOUNDARY=1, OPEN_BOUNDARY=2, INTERPOLATED_BOUNDARY=6
INTEGER, PARAMETER :: DIRICHLET=1, NEUMANN=2
END MODULE GLOBAL_CONSTANTS

! Stand-ins for the FDS derived types: only the components the loop at pres.f90:65-228 reads.
MODULE FDS_TYPES_STUB
USE PRECISION_PARAMETERS
IMPLICIT NONE
TYPE WALL_TYPE
   INTEGER :: BC_INDEX=0,B1_INDEX=0,VENT_INDEX=0,BOUNDARY_TYPE=0
END TYPE WALL_TYPE
TYPE EXTERNAL_WALL_TYPE
   INTEGER :: PRESSURE_BC_TYPE=0,NOM=0,IIO_MIN=1,JJO_MIN=1,KKO_MIN=1
   REAL(EB) :: DUNDT=0._EB
END TYPE EXTERNAL_WALL_TYPE
TYPE BOUNDARY_COORD_TYPE
   INTEGER :: II=0,JJ=0,KK=0,IOR=0
END TYPE BOUNDARY_COORD_TYPE
TYPE BOUNDARY_PROP1_TYPE
   REAL(EB) :: T_IGN=0._EB,RHO_F=1._EB
END TYPE BOUNDARY_PROP1_TYPE
TYPE VENTS_TYPE
   INTEGER :: PRESSURE_RAMP_INDEX=0,N_EDDY=0,IOR=0
   REAL(EB) :: DYNAMIC_PRESSURE=0._EB
   REAL(EB), ALLOCATABLE, DIMENSION(:,:) :: U_EDDY,V_EDDY,W_EDDY
END TYPE VENTS_TYPE
TYPE MESH_STUB_TYPE
   REAL(EB), ALLOCATABLE, DIMENSION(:) :: DX,DY,DZ
END TYPE MESH_STUB_TYPE
END MODULE FDS_TYPES_STUB

MODULE REF_IO
USE PRECISION_PARAMETERS
IMPLICIT NONE
INTEGER :: LU=77
INTEGER(8) :: RNG_STATE=88172645463325252_8
INTERFACE PUT
   MODULE PROCEDURE PUT_R1,PUT_R2,PUT_R3,PUT_I1,PUT_RS,PUT_IS
END INTERFACE PUT
CONTAINS
SUBROUTINE OPEN_CASE(FN)
CHARACTER(*), INTENT(IN) :: FN
OPEN(LU,FILE=FN,ACCESS='stream',FORM='unformatted',STATUS='REPLACE')
END SUBROUTINE OPEN_CASE
SUBROUTINE CLOSE_CASE
CLOSE(LU)
END SUBROUTINE CLOSE_CASE
SUBROUTINE HEAD(NAME,KIND_,RANK_,DIMS)
CHARACTER(*), INTENT(IN) :: NAME
INTEGER, INTENT(IN) :: KIND_,RANK_,DIMS(:)
CHARACTER(16) :: N16
N16 = NAME
WRITE(LU) N16,INT(KIND_,4),INT(RANK_,4),INT(DIMS(1:RANK_),4)
END SUBROUTINE HEAD
SUBROUTINE PUT_R1(NAME,A)
CHARACTER(*), INTENT(IN) :: NAME
REAL(EB), INTENT(IN) :: A(:)
CALL HEAD(NAME,2,1,SHAPE(A)) ; WRITE(LU) A
END SUBROUTINE PUT_R1
SUBROUTINE PUT_R2(NAME,A)
CHARACTER(*), INTENT(IN) :: NAME
REAL(EB), INTENT(IN) :: A(:,:)
CALL HEAD(NAME,2,2,SHAPE(A)) ; WRITE(LU) A
END SUBROUTINE PUT_R2
SUBROUTINE PUT_R3(NAME,A)
CHARACTER(*), INTENT(IN) :: NAME
REAL(EB), INTENT(IN) :: A(:,:,:)
CALL HEAD(NAME,2,3,SHAPE(A)) ; WRITE(LU) A
END SUBROUTINE PUT_R3
SUBROUTINE PUT_I1(NAME,A)
CHARACTER(*), INTENT(IN) :: NAME
INTEGER, INTENT(IN) :: A(:)
CALL HEAD(NAME,1,1,SHAPE(A)) ; WRITE(LU) INT(A,4)
END SUBROUTINE PUT_I1
SUBROUTINE PUT_RS(NAME,X)
CHARACTER(*), INTENT(IN) :: NAME
REAL(EB), INTENT(IN) :: X
CALL PUT_R1(NAME,(/X/))
END SUBROUTINE PUT_RS
SUBROUTINE PUT_IS(NAME,N)
CHARACTER(*), INTENT(IN) :: NAME
INTEGER, INTENT(IN) :: N
CALL PUT_I1(NAME,(/N/))
END SUBROUTINE PUT_IS

! xorshift64 generator (bit operations only: reproducible with every compiler)
FUNCTION URAND() RESULT(U)
REAL(EB) :: U
RNG_STATE = IEOR(RNG_STATE,ISHFT(RNG_STATE,13))
RNG_STATE = IEOR(RNG_STATE,ISHFT(RNG_STATE,-7))
RNG_STATE = IEOR(RNG_STATE,ISHFT(RNG_STATE,17))
U = REAL(ISHFT(RNG_STATE,-11),EB)*(2._EB**(-53))
END FUNCTION URAND
! A value of random sign and of magnitude spread over several binades, so operation order changes the rounding.
FUNCTION RV() RESULT(V)
REAL(EB) :: V,A,B
A = URAND() ; B = URAND()
V = (A-0.5_EB)*2._EB**(INT(8._EB*B)-4)
END FUNCTION RV
FUNCTION RP() RESULT(V)   ! positive
REAL(EB) :: V
V = 0.05_EB + URAND()*2._EB**(INT(4._EB*URAND())-2)
END FUNCTION RP
FUNCTION RI(N) RESULT(M)  ! integer in 1..N
INTEGER, INTENT(IN) :: N
INTEGER :: M
M = MIN(N,1+INT(URAND()*REAL(N,EB)))
END FUNCTION RI
SUBROUTINE FILL3(A)
REAL(EB), INTENT(OUT) :: A(:,:,:)
INTEGER :: I,J,K
DO K=1,SIZE(A,3) ; DO J=1,SIZE(A,2) ; DO I=1,SIZE(A,1) ; A(I,J,K)=RV() ; ENDDO ; ENDDO ; ENDDO
END SUBROUTINE FILL3
SUBROUTINE ZSOME(A)   ! set about 15 % of the entries to exactly zero (sign tests of the velocities)
REAL(EB), INTENT(INOUT) :: A(:,:,:)
INTEGER :: I,J,K
DO K=1,SIZE(A,3) ; DO J=1,SIZE(A,2) ; DO I=1,SIZE(A,1) ; IF (URAND()<0.15_EB) A(I,J,K)=0._EB ; ENDDO ; ENDDO ; ENDDO
END SUBROUTINE ZSOME
SUBROUTINE FILL2(A)
REAL(EB), INTENT(OUT) :: A(:,:)
INTEGER :: I,J
DO J=1,SIZE(A,2) ; DO I=1,SIZE(A,1) ; A(I,J)=RV() ; ENDDO ; ENDDO
END SUBROUTINE FILL2
SUBROUTINE FILL1(A,POS)
REAL(EB), INTENT(OUT) :: A(:)
LOGICAL, INTENT(IN) :: POS
INTEGER :: I
DO I=1,SIZE(A) ; IF (POS) THEN ; A(I)=RP() ; ELSE ; A(I)=RV() ; ENDIF ; ENDDO
END SUBROUTINE FILL1
END MODULE REF_IO

MODULE CASES
USE PRECISION_PARAMETERS
IMPLICIT NONE
CONTAINS

! ---------------------------------------------------------------------------------------------------------------------------
! L1211: PRESSURE_SOLVER_COMPUTE_RHS, PRHS for IPS 1/4/7 (3-D branch)
SUBROUTINE CASE_L1211(OUTDIR,TAG,IBAR,JBAR,KBAR,PERIODIC_LD)
USE PRECISION_PARAMETERS
USE REF_IO
IMPLICIT NONE
CHARACTER(*), INTENT(IN) :: OUTDIR,TAG
INTEGER, INTENT(IN) :: IBAR,JBAR,KBAR
LOGICAL, INTENT(IN) :: PERIODIC_LD   ! PRHS leading dimensions IBAR,JBAR,KBAR instead of IBAR+1,JBAR+1,KBAR+1
INTEGER :: IBP1,JBP1,KBP1,ITRN,JTRN,KTRN,I,J,K
REAL(EB) :: TRM1,TRM2,TRM3,TRM4
REAL(EB), ALLOCATABLE, DIMENSION(:,:,:) :: FVX,FVY,FVZ,DDDT,PRHS
REAL(EB), ALLOCATABLE, DIMENSION(:) :: RDX,RDY,RDZ
IBP1=IBAR+1 ; JBP1=JBAR+1 ; KBP1=KBAR+1
ITRN=IBP1 ; JTRN=JBP1 ; KTRN=KBP1
IF (PERIODIC_LD) THEN ; ITRN=IBAR ; JTRN=JBAR ; KTRN=KBAR ; ENDIF
IF (JBAR==1) JTRN=1
ALLOCATE(FVX(0:IBP1,0:JBP1,0:KBP1),FVY(0:IBP1,0:JBP1,0:KBP1),FVZ(0:IBP1,0:JBP1,0:KBP1),DDDT(0:IBP1,0:JBP1,0:KBP1))
ALLOCATE(PRHS(ITRN,JTRN,KTRN),RDX(0:IBP1),RDY(0:JBP1),RDZ(0:KBP1))
CALL FILL3(FVX) ; CALL FILL3(FVY) ; CALL FILL3(FVZ) ; CALL FILL3(DDDT) ; CALL FILL3(PRHS)
CALL FILL1(RDX,.TRUE.) ; CALL FILL1(RDY,.TRUE.) ; CALL FILL1(RDZ,.TRUE.)
CALL OPEN_CASE(OUTDIR//'/L1211_'//TAG//'.bin')
CALL PUT('IBAR',IBAR) ; CALL PUT('JBAR',JBAR) ; CALL PUT('KBAR',KBAR)
CALL PUT('FVX',FVX) ; CALL PUT('FVY',FVY) ; CALL PUT('FVZ',FVZ) ; CALL PUT('DDDT',DDDT)
CALL PUT('RDX',RDX) ; CALL PUT('RDY',RDY) ; CALL PUT('RDZ',RDZ) ; CALL PUT('PRHS_IN',PRHS)
!@@L1211@@
CALL PUT('PRHS_OUT',PRHS)
CALL CLOSE_CASE
END SUBROUTINE CASE_L1211

! ---------------------------------------------------------------------------------------------------------------------------
! L1207: PRESSURE_SOLVER_CHECK_RESIDUALS, P = RHOP*(HP-KRES) over the full box
SUBROUTINE CASE_L1207(OUTDIR,TAG,IBAR,JBAR,KBAR)
USE PRECISION_PARAMETERS
USE REF_IO
IMPLICIT NONE
CHARACTER(*), INTENT(IN) :: OUTDIR,TAG
INTEGER, INTENT(IN) :: IBAR,JBAR,KBAR
INTEGER :: IBP1,JBP1,KBP1,I,J,K
REAL(EB), ALLOCATABLE, TARGET, DIMENSION(:,:,:) :: RHO,H,KRES,WORK7
REAL(EB), POINTER, DIMENSION(:,:,:) :: P,HP,RHOP
IBP1=IBAR+1 ; JBP1=JBAR+1 ; KBP1=KBAR+1
ALLOCATE(RHO(-1:IBP1+1,-1:JBP1+1,-1:KBP1+1),H(0:IBP1,0:JBP1,0:KBP1),KRES(0:IBP1,0:JBP1,0:KBP1),WORK7(0:IBP1,0:JBP1,0:KBP1))
CALL FILL3(RHO) ; CALL FILL3(H) ; CALL FILL3(KRES) ; WORK7 = -7.77E+77_EB
P => WORK7 ; HP => H ; RHOP => RHO
CALL OPEN_CASE(OUTDIR//'/L1207_'//TAG//'.bin')
CALL PUT('IBAR',IBAR) ; CALL PUT('JBAR',JBAR) ; CALL PUT('KBAR',KBAR)
CALL PUT('RHO',RHO) ; CALL PUT('H',H) ; CALL PUT('KRES',KRES)
!@@L1207@@
CALL PUT('P_OUT',WORK7)
CALL CLOSE_CASE
END SUBROUTINE CASE_L1207

! ---------------------------------------------------------------------------------------------------------------------------
! L1220, L1221, L1222: H boundary fill in x, y, z
SUBROUTINE CASE_HBC(OUTDIR,TAG,IBAR,JBAR,KBAR,LBC,MBC,NBC)
USE PRECISION_PARAMETERS
USE REF_IO
IMPLICIT NONE
CHARACTER(*), INTENT(IN) :: OUTDIR,TAG
INTEGER, INTENT(IN) :: IBAR,JBAR,KBAR,LBC,MBC,NBC
INTEGER :: IBP1,JBP1,KBP1,JDIM,I,J,K
REAL(EB) :: DXI,DETA,DZETA
REAL(EB), ALLOCATABLE, TARGET, DIMENSION(:,:,:) :: H
REAL(EB), POINTER, DIMENSION(:,:,:) :: HP
REAL(EB), ALLOCATABLE, DIMENSION(:,:) :: BXS,BXF,BYS,BYF,BZS,BZF
IBP1=IBAR+1 ; JBP1=JBAR+1 ; KBP1=KBAR+1
JDIM=JBP1 ; IF (JBAR==1) JDIM=1
ALLOCATE(H(0:IBP1,0:JBP1,0:KBP1),BXS(JDIM,KBP1),BXF(JDIM,KBP1),BYS(IBP1,KBP1),BYF(IBP1,KBP1),BZS(IBP1,JDIM),BZF(IBP1,JDIM))
CALL FILL3(H) ; CALL FILL2(BXS) ; CALL FILL2(BXF) ; CALL FILL2(BYS) ; CALL FILL2(BYF) ; CALL FILL2(BZS) ; CALL FILL2(BZF)
DXI=RP() ; DETA=RP() ; DZETA=RP()
HP => H
CALL OPEN_CASE(OUTDIR//'/HBC_'//TAG//'.bin')
CALL PUT('IBAR',IBAR) ; CALL PUT('JBAR',JBAR) ; CALL PUT('KBAR',KBAR)
CALL PUT('LBC',LBC) ; CALL PUT('MBC',MBC) ; CALL PUT('NBC',NBC)
CALL PUT('DXI',DXI) ; CALL PUT('DETA',DETA) ; CALL PUT('DZETA',DZETA)
CALL PUT('BXS',BXS) ; CALL PUT('BXF',BXF) ; CALL PUT('BYS',BYS) ; CALL PUT('BYF',BYF) ; CALL PUT('BZS',BZS) ; CALL PUT('BZF',BZF)
CALL PUT('H_IN',H)
!@@L1220@@
!@@L1221@@
!@@L1222@@
CALL PUT('H_OUT',H)
CALL CLOSE_CASE
END SUBROUTINE CASE_HBC

! ---------------------------------------------------------------------------------------------------------------------------
! L1209: Poisson boundary arrays BXS..BZF from the external wall cells
SUBROUTINE CASE_L1209(OUTDIR,TAG,IBAR,JBAR,KBAR,NWALL,OPEN_WIND,T_BEGIN_IN)
USE PRECISION_PARAMETERS
USE GLOBAL_CONSTANTS
USE FDS_TYPES_STUB
USE REF_IO
IMPLICIT NONE
CHARACTER(*), INTENT(IN) :: OUTDIR,TAG
INTEGER, INTENT(IN) :: IBAR,JBAR,KBAR,NWALL
LOGICAL, INTENT(IN) :: OPEN_WIND
REAL(EB), INTENT(IN) :: T_BEGIN_IN
INTEGER, PARAMETER :: NNOM=3,NVENT=4,NDO=6
INTEGER :: IBP1,JBP1,KBP1,JDIM,I,J,K,IW,IOR,NOM,N_EXTERNAL_WALL_CELLS,IA,IV,R
REAL(EB) :: T,DT,T_BEGIN,U0,V0,W0,TSI,TIME_RAMP_FACTOR,DX_OTHER,DY_OTHER,DZ_OTHER,P_EXTERNAL,VEL_EDDY,H0
LOGICAL :: OPEN_WIND_BOUNDARY
TYPE (WALL_TYPE), ALLOCATABLE, TARGET, DIMENSION(:) :: WALL
TYPE (EXTERNAL_WALL_TYPE), ALLOCATABLE, TARGET, DIMENSION(:) :: EXTERNAL_WALL
TYPE (BOUNDARY_COORD_TYPE), ALLOCATABLE, TARGET, DIMENSION(:) :: BOUNDARY_COORD
TYPE (BOUNDARY_PROP1_TYPE), ALLOCATABLE, TARGET, DIMENSION(:) :: BOUNDARY_PROP1
TYPE (VENTS_TYPE), ALLOCATABLE, TARGET, DIMENSION(:) :: VENTS
TYPE (MESH_STUB_TYPE) :: MESHES(NNOM)
TYPE (VENTS_TYPE), POINTER :: VT
TYPE (WALL_TYPE), POINTER :: WC
TYPE (BOUNDARY_COORD_TYPE), POINTER :: BC
TYPE (BOUNDARY_PROP1_TYPE), POINTER :: B1
TYPE (EXTERNAL_WALL_TYPE), POINTER :: EWC
REAL(EB), ALLOCATABLE, TARGET, DIMENSION(:,:,:) :: HPA,KRES,UUA,VVA,WWA,FVX,FVY,FVZ
REAL(EB), POINTER, DIMENSION(:,:,:) :: HP,UU,VV,WW
REAL(EB), ALLOCATABLE, DIMENSION(:,:) :: BXS,BXF,BYS,BYF,BZS,BZF
REAL(EB), ALLOCATABLE, DIMENSION(:) :: HX,HY,HZ,DX,DY,DZ,RDXN,RDYN,RDZN,U_WIND,V_WIND,W_WIND,WALL_WORK1
INTEGER, ALLOCATABLE, DIMENSION(:) :: W_I,W_J,W_K,W_IOR,W_PBC,W_BT,W_VENT,W_NOM,W_IIO,W_JJO,W_KKO
REAL(EB), ALLOCATABLE, DIMENSION(:) :: W_DUNDT,W_TIGN,W_RHOF,V_DYNP
INTEGER, ALLOCATABLE, DIMENSION(:) :: V_RAMP,V_NEDDY,V_IOR
REAL(EB), ALLOCATABLE, DIMENSION(:,:) :: M_DX,M_DY,M_DZ
REAL(EB), ALLOCATABLE, DIMENSION(:,:,:) :: V_UE,V_VE,V_WE
IBP1=IBAR+1 ; JBP1=JBAR+1 ; KBP1=KBAR+1
JDIM=JBP1 ; IF (JBAR==1) JDIM=1
N_EXTERNAL_WALL_CELLS=NWALL
OPEN_WIND_BOUNDARY=OPEN_WIND
T_BEGIN=T_BEGIN_IN ; T=T_BEGIN+0.37_EB*RP() ; DT=0.003_EB*RP() ; U0=RV() ; V0=RV() ; W0=RV()
ALLOCATE(HPA(0:IBP1,0:JBP1,0:KBP1),KRES(0:IBP1,0:JBP1,0:KBP1),UUA(0:IBP1,0:JBP1,0:KBP1),VVA(0:IBP1,0:JBP1,0:KBP1),WWA(0:IBP1,0:JBP1,0:KBP1))
ALLOCATE(FVX(0:IBP1,0:JBP1,0:KBP1),FVY(0:IBP1,0:JBP1,0:KBP1),FVZ(0:IBP1,0:JBP1,0:KBP1))
CALL FILL3(HPA) ; CALL FILL3(KRES) ; CALL FILL3(UUA) ; CALL FILL3(VVA) ; CALL FILL3(WWA) ; CALL FILL3(FVX) ; CALL FILL3(FVY) ; CALL FILL3(FVZ)
CALL ZSOME(UUA) ; CALL ZSOME(VVA) ; CALL ZSOME(WWA)
HP => HPA ; UU => UUA ; VV => VVA ; WW => WWA
ALLOCATE(BXS(JDIM,KBP1),BXF(JDIM,KBP1),BYS(IBP1,KBP1),BYF(IBP1,KBP1),BZS(IBP1,JDIM),BZF(IBP1,JDIM))
CALL FILL2(BXS) ; CALL FILL2(BXF) ; CALL FILL2(BYS) ; CALL FILL2(BYF) ; CALL FILL2(BZS) ; CALL FILL2(BZF)
ALLOCATE(HX(0:IBP1),HY(0:JBP1),HZ(0:KBP1),DX(1:IBAR),DY(1:JBAR),DZ(1:KBAR),RDXN(0:IBAR),RDYN(0:JBAR),RDZN(0:KBAR))
ALLOCATE(U_WIND(0:KBP1),V_WIND(0:KBP1),W_WIND(0:KBP1),WALL_WORK1(NWALL))
CALL FILL1(HX,.FALSE.) ; CALL FILL1(HY,.FALSE.) ; CALL FILL1(HZ,.FALSE.)
CALL FILL1(DX,.TRUE.) ; CALL FILL1(DY,.TRUE.) ; CALL FILL1(DZ,.TRUE.)
CALL FILL1(RDXN,.TRUE.) ; CALL FILL1(RDYN,.TRUE.) ; CALL FILL1(RDZN,.TRUE.)
CALL FILL1(U_WIND,.FALSE.) ; CALL FILL1(V_WIND,.FALSE.) ; CALL FILL1(W_WIND,.FALSE.) ; CALL FILL1(WALL_WORK1,.FALSE.)
DO NOM=1,NNOM
   ALLOCATE(MESHES(NOM)%DX(NDO),MESHES(NOM)%DY(NDO),MESHES(NOM)%DZ(NDO))
   CALL FILL1(MESHES(NOM)%DX,.TRUE.) ; CALL FILL1(MESHES(NOM)%DY,.TRUE.) ; CALL FILL1(MESHES(NOM)%DZ,.TRUE.)
ENDDO
ALLOCATE(VENTS(NVENT))
DO IV=1,NVENT
   VENTS(IV)%PRESSURE_RAMP_INDEX=MOD(IV,3)        ! 1,2,0,1
   VENTS(IV)%DYNAMIC_PRESSURE=RV()
   VENTS(IV)%N_EDDY=0 ; IF (MOD(IV,2)==0) VENTS(IV)%N_EDDY=3
   VENTS(IV)%IOR=(1+MOD(IV+1,3))*(1-2*MOD(IV/2,2))   ! +-1..3
   ALLOCATE(VENTS(IV)%U_EDDY(JBP1,KBP1),VENTS(IV)%V_EDDY(IBP1,KBP1),VENTS(IV)%W_EDDY(IBP1,JBP1))
   CALL FILL2(VENTS(IV)%U_EDDY) ; CALL FILL2(VENTS(IV)%V_EDDY) ; CALL FILL2(VENTS(IV)%W_EDDY)
ENDDO
ALLOCATE(WALL(NWALL),EXTERNAL_WALL(NWALL),BOUNDARY_COORD(NWALL),BOUNDARY_PROP1(NWALL))
DO IW=1,NWALL
   WALL(IW)%BC_INDEX=IW ; WALL(IW)%B1_INDEX=IW
   IOR = (1+MOD(IW+RI(2),3))*(1-2*MOD(RI(7),2))      ! all six orientations, random order
   IA=ABS(IOR)
   BOUNDARY_COORD(IW)%IOR=IOR
   BOUNDARY_COORD(IW)%II=RI(IBAR) ; BOUNDARY_COORD(IW)%JJ=RI(JBAR) ; BOUNDARY_COORD(IW)%KK=RI(KBAR)
   R=RI(3) ; EXTERNAL_WALL(IW)%PRESSURE_BC_TYPE=0 ; IF (R==1) EXTERNAL_WALL(IW)%PRESSURE_BC_TYPE=NEUMANN
   IF (R==2.OR.R==3) EXTERNAL_WALL(IW)%PRESSURE_BC_TYPE=DIRICHLET
   R=RI(6) ; WALL(IW)%BOUNDARY_TYPE=SOLID_BOUNDARY
   IF (R==1.OR.R==2) WALL(IW)%BOUNDARY_TYPE=OPEN_BOUNDARY
   IF (R==3) WALL(IW)%BOUNDARY_TYPE=INTERPOLATED_BOUNDARY
   IF (R==4) WALL(IW)%BOUNDARY_TYPE=NULL_BOUNDARY
   EXTERNAL_WALL(IW)%DUNDT=RV()
   EXTERNAL_WALL(IW)%NOM=RI(NNOM) ; EXTERNAL_WALL(IW)%IIO_MIN=RI(NDO) ; EXTERNAL_WALL(IW)%JJO_MIN=RI(NDO) ; EXTERNAL_WALL(IW)%KKO_MIN=RI(NDO)
   WALL(IW)%VENT_INDEX=RI(NVENT)
   R=RI(4)
   SELECT CASE(R)
      CASE(1) ; BOUNDARY_PROP1(IW)%T_IGN=T_BEGIN
      CASE(2) ; BOUNDARY_PROP1(IW)%T_IGN=T_BEGIN+1.E-15_EB      ! inside the 20*EPSILON window when T_BEGIN=0
      CASE(3) ; BOUNDARY_PROP1(IW)%T_IGN=T_BEGIN+1.E-14_EB      ! outside
      CASE(4) ; BOUNDARY_PROP1(IW)%T_IGN=T_BEGIN-3._EB
   END SELECT
   BOUNDARY_PROP1(IW)%RHO_F=RP()
ENDDO
! wall list as data
ALLOCATE(W_I(NWALL),W_J(NWALL),W_K(NWALL),W_IOR(NWALL),W_PBC(NWALL),W_BT(NWALL),W_VENT(NWALL),W_NOM(NWALL),W_IIO(NWALL),W_JJO(NWALL),W_KKO(NWALL))
ALLOCATE(W_DUNDT(NWALL),W_TIGN(NWALL),W_RHOF(NWALL))
DO IW=1,NWALL
   W_I(IW)=BOUNDARY_COORD(IW)%II ; W_J(IW)=BOUNDARY_COORD(IW)%JJ ; W_K(IW)=BOUNDARY_COORD(IW)%KK ; W_IOR(IW)=BOUNDARY_COORD(IW)%IOR
   W_PBC(IW)=EXTERNAL_WALL(IW)%PRESSURE_BC_TYPE ; W_BT(IW)=WALL(IW)%BOUNDARY_TYPE ; W_VENT(IW)=WALL(IW)%VENT_INDEX
   W_NOM(IW)=EXTERNAL_WALL(IW)%NOM ; W_IIO(IW)=EXTERNAL_WALL(IW)%IIO_MIN ; W_JJO(IW)=EXTERNAL_WALL(IW)%JJO_MIN ; W_KKO(IW)=EXTERNAL_WALL(IW)%KKO_MIN
   W_DUNDT(IW)=EXTERNAL_WALL(IW)%DUNDT ; W_TIGN(IW)=BOUNDARY_PROP1(IW)%T_IGN ; W_RHOF(IW)=BOUNDARY_PROP1(IW)%RHO_F
ENDDO
ALLOCATE(V_RAMP(NVENT),V_NEDDY(NVENT),V_IOR(NVENT),V_DYNP(NVENT),V_UE(JBP1,KBP1,NVENT),V_VE(IBP1,KBP1,NVENT),V_WE(IBP1,JBP1,NVENT))
DO IV=1,NVENT
   V_RAMP(IV)=VENTS(IV)%PRESSURE_RAMP_INDEX ; V_NEDDY(IV)=VENTS(IV)%N_EDDY ; V_IOR(IV)=VENTS(IV)%IOR ; V_DYNP(IV)=VENTS(IV)%DYNAMIC_PRESSURE
   V_UE(:,:,IV)=VENTS(IV)%U_EDDY ; V_VE(:,:,IV)=VENTS(IV)%V_EDDY ; V_WE(:,:,IV)=VENTS(IV)%W_EDDY
ENDDO
ALLOCATE(M_DX(NDO,NNOM),M_DY(NDO,NNOM),M_DZ(NDO,NNOM))
DO NOM=1,NNOM
   M_DX(:,NOM)=MESHES(NOM)%DX ; M_DY(:,NOM)=MESHES(NOM)%DY ; M_DZ(:,NOM)=MESHES(NOM)%DZ
ENDDO
CALL OPEN_CASE(OUTDIR//'/L1209_'//TAG//'.bin')
CALL PUT('IBAR',IBAR) ; CALL PUT('JBAR',JBAR) ; CALL PUT('KBAR',KBAR) ; CALL PUT('NWALL',NWALL)
CALL PUT('OPEN_WIND',MERGE(1,0,OPEN_WIND_BOUNDARY))
CALL PUT('T',T) ; CALL PUT('DT',DT) ; CALL PUT('T_BEGIN',T_BEGIN) ; CALL PUT('U0',U0) ; CALL PUT('V0',V0) ; CALL PUT('W0',W0)
CALL PUT('HP',HPA) ; CALL PUT('KRES',KRES) ; CALL PUT('UU',UUA) ; CALL PUT('VV',VVA) ; CALL PUT('WW',WWA)
CALL PUT('FVX',FVX) ; CALL PUT('FVY',FVY) ; CALL PUT('FVZ',FVZ)
CALL PUT('HX',HX) ; CALL PUT('HY',HY) ; CALL PUT('HZ',HZ) ; CALL PUT('DX',DX) ; CALL PUT('DY',DY) ; CALL PUT('DZ',DZ)
CALL PUT('RDXN',RDXN) ; CALL PUT('RDYN',RDYN) ; CALL PUT('RDZN',RDZN)
CALL PUT('U_WIND',U_WIND) ; CALL PUT('V_WIND',V_WIND) ; CALL PUT('W_WIND',W_WIND) ; CALL PUT('WALL_WORK1',WALL_WORK1)
CALL PUT('BXS_IN',BXS) ; CALL PUT('BXF_IN',BXF) ; CALL PUT('BYS_IN',BYS) ; CALL PUT('BYF_IN',BYF) ; CALL PUT('BZS_IN',BZS) ; CALL PUT('BZF_IN',BZF)
CALL PUT('W_I',W_I) ; CALL PUT('W_J',W_J) ; CALL PUT('W_K',W_K) ; CALL PUT('W_IOR',W_IOR) ; CALL PUT('W_PBC',W_PBC) ; CALL PUT('W_BT',W_BT)
CALL PUT('W_VENT',W_VENT) ; CALL PUT('W_NOM',W_NOM) ; CALL PUT('W_IIO',W_IIO) ; CALL PUT('W_JJO',W_JJO) ; CALL PUT('W_KKO',W_KKO)
CALL PUT('W_DUNDT',W_DUNDT) ; CALL PUT('W_TIGN',W_TIGN) ; CALL PUT('W_RHOF',W_RHOF)
CALL PUT('V_RAMP',V_RAMP) ; CALL PUT('V_NEDDY',V_NEDDY) ; CALL PUT('V_IOR',V_IOR) ; CALL PUT('V_DYNP',V_DYNP)
CALL PUT('V_UE',V_UE) ; CALL PUT('V_VE',V_VE) ; CALL PUT('V_WE',V_WE)
CALL PUT('M_DX',M_DX) ; CALL PUT('M_DY',M_DY) ; CALL PUT('M_DZ',M_DZ)
!@@L1209@@
CALL PUT('BXS_OUT',BXS) ; CALL PUT('BXF_OUT',BXF) ; CALL PUT('BYS_OUT',BYS) ; CALL PUT('BYF_OUT',BYF) ; CALL PUT('BZS_OUT',BZS) ; CALL PUT('BZF_OUT',BZF)
CALL CLOSE_CASE
END SUBROUTINE CASE_L1209

! Stand-in for EVALUATE_RAMP (math.f90): plain arithmetic, so the C++ lambda of the test reproduces it bit for bit.
FUNCTION EVALUATE_RAMP(X,RAMP_INDEX) RESULT(Y)
USE PRECISION_PARAMETERS
REAL(EB), INTENT(IN) :: X
INTEGER, INTENT(IN) :: RAMP_INDEX
REAL(EB) :: Y
IF (RAMP_INDEX<1) THEN
   Y = 1._EB+0.01_EB*X
ELSE
   Y = (X*X+0.75_EB*REAL(RAMP_INDEX,EB))/(1._EB+X*X)
ENDIF
END FUNCTION EVALUATE_RAMP


END MODULE CASES

PROGRAM REF_LOOPS
USE PRECISION_PARAMETERS
USE CASES
IMPLICIT NONE
CHARACTER(512) :: OUTDIR
CHARACTER(32) :: TAG
INTEGER :: N,LEN_,IB(5),JB(5),KB(5),S,NS
LOGICAL :: PL
CALL GET_COMMAND_ARGUMENT(1,OUTDIR,LEN_)
IF (LEN_<=0) STOP 'usage: ref_loops <outdir>'
OUTDIR=OUTDIR(1:LEN_)
NS=5
IB=(/6,8,1,17,3/) ; JB=(/5,1,1,4,2/) ; KB=(/4,7,1,9,5/)
DO S=1,NS
   DO N=0,1
      PL = (N==1)
      WRITE(TAG,'(A,I0,A,I0,A,I0,A,I0)') 'n',IB(S),'x',JB(S),'x',KB(S),'_p',N
      CALL CASE_L1211(TRIM(OUTDIR),TRIM(TAG),IB(S),JB(S),KB(S),PL)
   ENDDO
   WRITE(TAG,'(A,I0,A,I0,A,I0)') 'n',IB(S),'x',JB(S),'x',KB(S)
   CALL CASE_L1207(TRIM(OUTDIR),TRIM(TAG),IB(S),JB(S),KB(S))
ENDDO
! H boundary fill: every x code (0..6) against every y and z code (0..4) on a 3-D and a 2-D (JBAR=1) mesh
DO N=0,34
   DO S=1,2
      WRITE(TAG,'(A,I0,A,I0)') 'c',N,'_s',S
      IF (S==1) CALL CASE_HBC(TRIM(OUTDIR),TRIM(TAG),6,5,4,MOD(N,7),MOD(N,5),MOD(N+2,5))
      IF (S==2) CALL CASE_HBC(TRIM(OUTDIR),TRIM(TAG),7,1,6,MOD(N,7),MOD(N+1,5),MOD(N+3,5))
   ENDDO
ENDDO
! Poisson boundary arrays: three sizes (3-D, 2-D, thin), wind off and on, T_BEGIN 0 and 0.25
DO N=0,7
   WRITE(TAG,'(A,I0)') 'a',N
   CALL CASE_L1209(TRIM(OUTDIR),TRIM(TAG),6+MOD(N,2),5-MOD(N/2,2)*4,4+MOD(N,3),240,MOD(N,2)==1,0.25_EB*REAL(MOD(N/2,2),EB))
ENDDO
END PROGRAM REF_LOOPS
