&HEAD CHID='ldump_peryz', TITLE='Pressure loop dump: periodic in y and z (FISHPAK_BC=-1,0,0 gives MBC=NBC=0), closed in x, fire, obstruction' /
&MESH IJK=10,8,8, XB=0.0,1.0,0.0,0.8,0.0,0.8 /
&TIME T_END=0.2 /
&PRES FISHPAK_BC=-1,0,0 /
&DUMP SIG_FIGS=17, DT_HRR=1000., DT_DEVC=1000., DT_SLCF=1000. /
&REAC FUEL='PROPANE', SOOT_YIELD=0.01 /
&SURF ID='BURN', HRRPUA=500. /
&VENT XB=0.4,0.6,0.3,0.5,0.0,0.0, SURF_ID='BURN' /
&OBST XB=0.0,0.3,0.0,0.2,0.0,0.3 /
&VENT MB='YMIN', SURF_ID='PERIODIC' /
&VENT MB='YMAX', SURF_ID='PERIODIC' /
&VENT MB='ZMIN', SURF_ID='PERIODIC' /
&VENT MB='ZMAX', SURF_ID='PERIODIC' /
&TAIL /
