&HEAD CHID='ldump_openyz', TITLE='Pressure loop dump: open vents on both y faces, both z faces and the high-x face (IOR +-2, +3, -3, -1) with wind' /
&MESH IJK=10,10,10, XB=0.0,1.0,0.0,1.0,0.0,1.0 /
&TIME T_END=0.2 /
&DUMP SIG_FIGS=17, DT_HRR=1000., DT_DEVC=1000., DT_SLCF=1000. /
&WIND SPEED=2.0, DIRECTION=180. /
&REAC FUEL='PROPANE', SOOT_YIELD=0.01 /
&SURF ID='BURN', HRRPUA=500. /
&VENT XB=0.4,0.6,0.4,0.6,0.0,0.0, SURF_ID='BURN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT XB=0.0,0.3,0.0,1.0,0.0,0.0, SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /
&TAIL /
