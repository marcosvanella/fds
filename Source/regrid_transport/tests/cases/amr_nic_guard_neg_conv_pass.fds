&HEAD CHID='amr_nic_guard_neg_conv_pass', TITLE='Negative control for the AMR level-0 NIC guard that passes the input converter (race_test_1 layout, mesh 3 at 0.05, mesh 5 stretched in x)' /

! AMR line: MAX_LEVEL=0 (no refinement); BLOCKING_FACTOR=2 because the 34 x 18 level-0 cell domain is not divisible by the default 8
&AMR MAX_LEVEL=0, BLOCKING_FACTOR=2 /

&MESH IJK=14,18,32, XB=-0.85,-0.15,-0.45, 0.45, 0.00, 1.60 /
&MESH IJK=14,18,32, XB= 0.85, 0.15,-0.45, 0.45, 0.00, 1.60 /
&MESH IJK= 6, 6, 4, XB=-0.15, 0.15,-0.15, 0.15, 0.00, 0.20 /
&MESH IJK= 6, 6,28, XB=-0.15, 0.15,-0.15, 0.15, 0.20, 1.60 /
&MESH IJK= 6, 6,32, XB=-0.15, 0.15,-0.45,-0.15, 0.00, 1.60, TRNX_ID='XSTRETCH' /
&MESH IJK= 6, 6,32, XB=-0.15, 0.15, 0.15, 0.45, 0.00, 1.60 /

! Mesh 5 has 6 equal computational cells of 0.05 (what the input converter sees); TRNX_ID gives it the physical x cells
! 0.05, 0.025, 0.025, 0.10, 0.05, 0.05 (edges -0.15 -0.10 -0.075 -0.05 0.05 0.10 0.15). Piecewise linear, no end points (read.f90:1184-1216).
&TRNX ID='XSTRETCH', CC=-0.10, PC=-0.10 /
&TRNX ID='XSTRETCH', CC= 0.00, PC=-0.05 /
&TRNX ID='XSTRETCH', CC= 0.05, PC= 0.05 /

&TIME T_END=0.02 /

&REAC FUEL='N-HEXANE'
      CO_YIELD=0.100
      SOOT_YIELD=0.010 /

&SURF ID='FIRE'
      RGB=204,27,0
      MASS_FLUX(1)=0.0185
      SPEC_ID(1)='N-HEXANE'
      RAMP_MF='RAMP MLRPUA' /

&RAMP ID='RAMP MLRPUA', T= 0, F=0.3896 /
&RAMP ID='RAMP MLRPUA', T=10, F=0.318 /

&OBST XB=-0.100,0.100,-0.150,0.150,0,0.120, COLOR='WHITE' /

&VENT ID='poolfire', SURF_ID='FIRE', XB=-0.040,0.040,-0.040,0.040,0.120,0.120, XYZ=0,0,0.120, RADIUS=0.030 /

&DUMP DT_DEVC=0.1 /

&DEVC ID='TMP', XYZ=0,0,0.144, QUANTITY='TEMPERATURE', TIME_AVERAGED=.FALSE. /
&DEVC ID='VEL', XYZ=0,0,0.144, QUANTITY='VELOCITY', TIME_AVERAGED=.FALSE. /

&TAIL/
