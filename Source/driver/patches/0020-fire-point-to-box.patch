+#ifdef WITH_AMREX
+! Patch 0020: the combustion kernels of this file find the data of a box through POINT_TO_BOX (patches 0005/0007/0008, D-056) and the mesh object through FIRE_MESH,
+! so COMBUSTION_LOAD_BALANCED runs on a box of a refinement level > 0. Every CALL POINT_TO_MESH(NM) of this file becomes CALL POINT_TO_BOX(NM).
+#define POINT_TO_MESH POINT_TO_BOX
+#endif
 !> \brief Routines for computing combustion
 
 MODULE FIRE
@@ -32,6 +37,25 @@ PUBLIC COMBUSTION_LOAD_BALANCED,COMBUSTION_BC,CONDENSATION_EVAPORATION,GET_FLAME
 
 CONTAINS
 
+!> AMReX D-056 (POINT_TO_BOX, patch 0008): the mesh object of mesh NM, MESHES(NM) for a level-0 mesh and FINE_LEVEL(L)%BOX(IB) for a box of refinement level L.
+!> The routines of this file read NCHEM_ACTIVE_CELLS/NCHEM_ACTIVE_CC/N_CUTCELL_MESH of their mesh through it instead of MESHES(NM)%.
+FUNCTION FIRE_MESH(NM) RESULT(MB)
+INTEGER, INTENT(IN) :: NM
+TYPE (MESH_TYPE), POINTER :: MB
+#ifdef WITH_AMREX
+INTEGER :: LEV
+IF (NM>SIZE(MESHES)) THEN
+   DO LEV=1,SIZE(FINE_LEVEL)
+      IF (NM>FINE_LEVEL(LEV)%NM0 .AND. NM<=FINE_LEVEL(LEV)%NM0+FINE_LEVEL(LEV)%N_BOXES) THEN
+         MB=>FINE_LEVEL(LEV)%BOX(NM-FINE_LEVEL(LEV)%NM0) ; RETURN
+      ENDIF
+   ENDDO
+ENDIF
+#endif
+MB=>MESHES(NM)
+END FUNCTION FIRE_MESH
+
