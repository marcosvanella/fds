+#ifdef WITH_AMREX
+!> Fine-level mesh objects of the AMReX driver (D-056 option B): the mesh objects of the boxes of refinement level L>=1 live here, in a second array owned by the driver
+!> and indexed by level, NOT in MESHES. A box of level L has the FDS mesh number NM = FINE_LEVEL(L)%NM0 + IB (IB = 1..N_BOXES), which is always larger than SIZE(MESHES):
+!> MESHES, PROCESS, OMESH, the MPI maps and the level-0 mesh-count loops are untouched. BOX(IB) holds what POINT_TO_MESH_OBJECT needs (metrics, CELL/WALL tables, box state
+!> arrays); VIEW(IB) holds the pointer views of the AMReX data of the box (as BOX_VIEW(NM) does for level 0). The driver allocates and fills the array (driver file
+!> fds_fine_mesh.f90); no FDS routine does.
+TYPE FINE_LEVEL_TYPE
+   INTEGER :: NM0=0, N_BOXES=0
+   TYPE(MESH_TYPE), ALLOCATABLE :: BOX(:)
+   TYPE(BOX_VIEW_TYPE), ALLOCATABLE :: VIEW(:)
+END TYPE FINE_LEVEL_TYPE
+TYPE(FINE_LEVEL_TYPE), ALLOCATABLE, TARGET, SAVE :: FINE_LEVEL(:)
+#endif
+
 CONTAINS
 
 
