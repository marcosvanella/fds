&HEAD CHID='rad_init_csiro', TITLE='CSIRO-like t=0 radiation: stratified TMP_0, DIRT ground (emissivity 0.9), static grass bed; full-coverage L1 QR = 1L (run_rad_init_csiro_check.sh)' /
&MESH IJK=8,8,4, XB=0.,4.,0.,4.,0.,2. /
&TIME T_END=0.1 /
&MISC SIMULATION_MODE='SVLES', TMPA=32. /
&WIND SPEED=4.6, Z_REF=2., DIRECTION=270., L=-500., Z_0=0.03 /
&DUMP DT_HRR=0.05, DT_DEVC=0.05 /
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /
&MATL ID='DIRT', CONDUCTIVITY=0.25, SPECIFIC_HEAT=2., DENSITY=1300. /
&SURF ID='GROUND', DEFAULT=T, MATL_ID='DIRT', THICKNESS=0.2 /
&SURF ID='wet vegetation', MATL_ID(1,1:1)='GENERIC VEGETATION', MOISTURE_CONTENT=0.063, SURFACE_VOLUME_RATIO=9770., LENGTH=0.20, GEOMETRY='CYLINDRICAL' /
&CATF OTHER_FILES='vegetation_model.txt' /
&PART ID='blade of grass', SAMPLING_FACTOR=5, SURF_ID='wet vegetation', DRAG_COEFFICIENT=2.8, STATIC=T /
&INIT PART_ID='blade of grass', XB=0.5,3.5,0.5,3.5,0.,0.25, N_PARTICLES_PER_CELL=1, CELL_CENTERED=T, MASS_PER_VOLUME=1.33, DRY=T /
&AMR BLOCKING_FACTOR=2 /
&TAIL /
