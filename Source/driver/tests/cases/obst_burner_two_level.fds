&HEAD CHID='obst_burner', TITLE='Stage 1: simple_test, reactions off, fuel inflow only' /
&MESH IJK=36,24,24, XB=0.0,3.6,0.0,2.4,0.0,2.4 /
&TIME T_END=60.0 /
&MISC SIMULATION_MODE='VLES' /
&RADI RADIATION=.FALSE. /
&SPEC ID='PROPANE' /
&SPEC ID='SOOT' /
&SURF ID='BURNER', SPEC_ID='PROPANE', MASS_FLUX=0.02158, COLOR='RED' /
&OBST XB=0.0,0.4,1.0,1.4,0.0,0.2 /
&VENT XB=0.0,0.4,1.0,1.4,0.2,0.2, SURF_ID='BURNER' /
&VENT XB=3.6,3.6,0.8,1.6,0.0,2.0, SURF_ID='OPEN' /
&DUMP MASS_FILE=.TRUE. /
&AMR BLOCKING_FACTOR=4 /
&TAIL /
