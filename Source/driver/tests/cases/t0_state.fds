&HEAD CHID='t0_state', TITLE='t=0 state of a full-coverage fine level equals the 1-level one at the same dx (run_t0_state_check.sh)' /
&MESH IJK=8,8,4, XB=0.,4.,0.,4.,0.,2. /
&TIME T_END=0.1 /
&DUMP DT_HRR=0.05, DT_DEVC=0.05 /
&INIT XB=1.,2.5,1.,2.,0.5,1., TEMPERATURE=900. /
&SURF ID='BLACK', EMISSIVITY=1., DEFAULT=T /
&VENT MB='ZMAX', SURF_ID='OPEN' /
&AMR BLOCKING_FACTOR=2 /
&TAIL /
