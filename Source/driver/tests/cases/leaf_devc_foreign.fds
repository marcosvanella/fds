! W3 cut-down derived from stock ce1f659 Validation/CSIRO_Grassland_Fires/FDS_Input_Files/Case_C064.fds
! Changes: CHID, MESH/MULT, T_END, ignition VENT, road VENT, INIT and DEVC extents clipped; bed and ignition kept 5 m and 10 m inside the lateral OPEN boundaries (as stock keeps them 10 m and 35 m inside) because a bed reaching the boundary went unstable at t=29 s. Physics unchanged.
! Leaf devc foreign test (run_leaf_devc_foreign_check.sh): wall statistics over the ground (WMX..WMI) and gas devices F1..FMI inside the interior fine boxes that FDS_AMR_DEBUG_FOREIGN_BOXES moves to a non-parent rank.
&HEAD CHID='c', TITLE='Australian Grassland Fire Experiment, Case C064' /
&AMR MAX_LEVEL=0, BLOCKING_FACTOR=2, MAX_GRID_SIZE=32 /

&MESH IJK=20,20,20, XB=-10.0,10.0,-20.0,0.0,0.0,20.0 /
&MESH IJK=20,20,20, XB=10.0,30.0,-20.0,0.0,0.0,20.0 /
&MESH IJK=20,20,20, XB=-10.0,10.0,0.0,20.0,0.0,20.0 /
&MESH IJK=20,20,20, XB=10.0,30.0,0.0,20.0,0.0,20.0 /

&TIME T_END=0.5 /

&MISC SIMULATION_MODE='SVLES', TMPA=32. /

&WIND SPEED=4.6, Z_REF=2., DIRECTION=270., L=-500., Z_0=0.03 /

&SURF ID='IGNITION', HRRPUA=1500., COLOR='RED', TMP_FRONT=100., RAMP_Q='ignitor' /
&RAMP ID='ignitor', T= 0., F=0. /
&RAMP ID='ignitor', T= 1., F=1. /
&RAMP ID='ignitor', T= 5., F=1. /
&RAMP ID='ignitor', T= 6., F=0. /

&VENT XB=0.0,1.6,-10.,10.,0.,0., SURF_ID='IGNITION', XYZ=0,0,0, SPREAD_RATE=1. /

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /

&SURF ID='ROAD'
      COLOR='BEIGE'
      MATL_ID='DIRT'
      THICKNESS=0.2 /


&VENT XB= -3,  0,-20, 20,0,0, SURF_ID='ROAD' /

&MATL ID='DIRT'
      CONDUCTIVITY = 0.25
      SPECIFIC_HEAT = 2.
      DENSITY = 1300. /

&SURF ID='GROUND'
      DEFAULT=T
      MATL_ID='DIRT'
      THICKNESS=0.2 /

&SURF ID                        = 'wet vegetation'
      MATL_ID(1,1:1)            = 'GENERIC VEGETATION'
      MOISTURE_CONTENT         = 0.063
      SURFACE_VOLUME_RATIO      = 9770.
      LENGTH                    = 0.20
      GEOMETRY                  = 'CYLINDRICAL' /

&CATF OTHER_FILES='vegetation_model.txt' /

&PART ID='blade of grass'
      SAMPLING_FACTOR=5
      SURF_ID='wet vegetation'
      PROP_ID='grass image'
      DRAG_COEFFICIENT=2.8
      QUANTITIES='PARTICLE TEMPERATURE','PARTICLE MASS'
      STATIC=T
      COLOR='BROWN' /

&INIT PART_ID='blade of grass', XB=0.,25.,-15.,15.,0.00,0.21, N_PARTICLES_PER_CELL=1, CELL_CENTERED=T, MASS_PER_VOLUME=1.33, DRY=T /

&PROP ID='grass image', SMOKEVIEW_ID='TUBE', SMOKEVIEW_PARAMETERS='L=0.20','D=0.0004','DIRZ=1' /

&DUMP DT_HRR=0.1, DT_DEVC=0.1, MASS_FILE=T, DT_MASS=0.1, SIG_FIGS=15, SIG_FIGS_EXP=3 /




&DEVC ID='x', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MAXLOC X', XB=-10,30,-1,0,0,1 /
&DEVC ID='D', QUANTITY='FIRE DEPTH', XB=-10,30,0,0,0.1,0.1 /
&DEVC ID='WMX', QUANTITY='WALL TEMPERATURE', SPATIAL_STATISTIC='MAX', XB=-10,30,-20,20,0,0 /
&DEVC ID='WMN', QUANTITY='WALL TEMPERATURE', SPATIAL_STATISTIC='MEAN', XB=-10,30,-20,20,0,0 /
&DEVC ID='WQI', QUANTITY='CONVECTIVE HEAT FLUX', SPATIAL_STATISTIC='SURFACE INTEGRAL', XB=-10,30,-20,20,0,0 /
&DEVC ID='WMI', QUANTITY='WALL TEMPERATURE', SPATIAL_STATISTIC='MIN', XB=-10,30,-20,20,0,0 /
&DEVC ID='F1', QUANTITY='TEMPERATURE', XYZ=-4.1,-8.1,5.1 /
&DEVC ID='F2', QUANTITY='TEMPERATURE', XYZ=1.1,-2.1,6.1 /
&DEVC ID='F3', QUANTITY='W-VELOCITY', XYZ=1.1,-8.1,11.1 /
&DEVC ID='F4', QUANTITY='TEMPERATURE', XYZ=-4.1,2.1,5.1 /
&DEVC ID='FMX', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MAX', XB=-7,3,-12,4,3,13 /
&DEVC ID='FMN', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MEAN', XB=-7,3,-12,4,3,13 /
&DEVC ID='FVI', QUANTITY='W-VELOCITY', SPATIAL_STATISTIC='VOLUME INTEGRAL', XB=-7,3,-12,4,3,13 /
&DEVC ID='FLX', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MAXLOC X', XB=-7,3,-12,4,3,13 /
&DEVC ID='FMI', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MIN', XB=-7,3,-12,4,3,13 /
&DEVC ID='T1', QUANTITY='TEMPERATURE', XYZ=2.0,0.,0.5 /
&DEVC ID='T2', QUANTITY='TEMPERATURE', XYZ=5.0,0.,1.0 /
&DEVC ID='U1', QUANTITY='U-VELOCITY', XYZ=5.0,0.,2.0 /
&DEVC ID='W1', QUANTITY='W-VELOCITY', XYZ=2.0,0.,2.0 /

&TAIL /
