&HEAD CHID='rte_factor_ranks', TITLE='Wide HRRPUA burner under a fixed level-1 patch, radiation on: RTE source correction factor at 1, 2, 4 ranks' /
&MESH IJK=32,8,16, XB=0.0,3.2,0.0,0.8,0.0,1.6, MPI_PROCESS=0 /
&MESH IJK=32,8,16, XB=0.0,3.2,0.8,1.6,0.0,1.6, MPI_PROCESS=1 /
&MESH IJK=32,8,16, XB=0.0,3.2,1.6,2.4,0.0,1.6, MPI_PROCESS=2 /
&MESH IJK=32,8,16, XB=0.0,3.2,2.4,3.2,0.0,1.6, MPI_PROCESS=3 /
&TIME T_END=1.0 /
&REAC FUEL='PROPANE', SOOT_YIELD=0.013 /
&SURF ID='BURNER', HRRPUA=730., COLOR='RED' /
&VENT XB=0.3,2.9,0.3,2.9,0.0,0.0, SURF_ID='BURNER' /
&VENT MB='ZMAX', SURF_ID='OPEN' /
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&DUMP DT_HRR=0.01, DT_DEVC=0.01, SIG_FIGS=15, SIG_FIGS_EXP=3 /
&DEVC ID='T0', QUANTITY='TEMPERATURE', XYZ=0.55,0.55,0.35 /
&DEVC ID='T1', QUANTITY='TEMPERATURE', XYZ=2.65,0.55,0.35 /
&DEVC ID='T2', QUANTITY='TEMPERATURE', XYZ=0.55,2.65,0.35 /
&DEVC ID='T3', QUANTITY='TEMPERATURE', XYZ=2.65,2.65,0.35 /
&DEVC ID='T4', QUANTITY='TEMPERATURE', XYZ=1.55,1.65,0.55 /
&DEVC ID='T5', QUANTITY='TEMPERATURE', XYZ=1.25,2.05,0.25 /
&AMR BLOCKING_FACTOR=2 /
&TAIL /
