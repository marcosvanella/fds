&HEAD CHID='devc_leaf_point', TITLE='Gas DEVCs on leaf cells: open_step with a fixed-temperature ground over two level-0 meshes (run_devc_leaf_point_check.sh)' /
&MESH IJK=4,8,4, XB=0.,2.,0.,4.,0.,2. /
&MESH IJK=4,8,4, XB=2.,4.,0.,4.,0.,2. /
&TIME T_END=2., DT=0.02, LOCK_TIME_STEP=.TRUE. /
&MISC SIMULATION_MODE='SVLES', TMPA=32., NOISE=.FALSE. /
&WIND SPEED=4.6, Z_REF=2., DIRECTION=270., L=-500., Z_0=0.03 /
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /
&MATL ID='DIRT', CONDUCTIVITY=0.25, SPECIFIC_HEAT=2., DENSITY=1300. /
&SURF ID='GROUND', DEFAULT=T, TMP_FRONT=32. /
&SURF ID='wet vegetation', MATL_ID(1,1:1)='GENERIC VEGETATION', MOISTURE_CONTENT=0.063, SURFACE_VOLUME_RATIO=9770., LENGTH=0.20, GEOMETRY='CYLINDRICAL' /
&CATF OTHER_FILES='vegetation_model.txt' /
&AMR BLOCKING_FACTOR=2 /
&RADI RADIATION=.FALSE. /
&DUMP SMOKE3D=.FALSE., DT_DEVC=1.E-6, DT_HRR=1.E6, SIG_FIGS=16, SIG_FIGS_EXP=3 /
&DEVC ID='M', QUANTITY='DENSITY', SPATIAL_STATISTIC='VOLUME INTEGRAL', XB=0,4,0,4,0,2 /
&DEVC ID='TM', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='VOLUME MEAN', XB=0,4,0,4,0,2 /
&DEVC ID='UM', QUANTITY='U-VELOCITY', SPATIAL_STATISTIC='VOLUME MEAN', XB=0,4,0,4,0,2 /
&DEVC ID='UMAX', QUANTITY='U-VELOCITY', SPATIAL_STATISTIC='MAX', XB=0,4,0,4,0,2 /
&DEVC ID='WMAX', QUANTITY='W-VELOCITY', SPATIAL_STATISTIC='MAX', XB=0,4,0,4,0,2 /
&DEVC ID='VMIN', QUANTITY='V-VELOCITY', SPATIAL_STATISTIC='MIN', XB=0,4,0,4,0,2 /
&DEVC ID='T1', QUANTITY='TEMPERATURE', XYZ=0.1,2.1,0.1 /
&DEVC ID='U1', QUANTITY='U-VELOCITY', XYZ=0.1,2.1,1.9 /
&DEVC ID='U2', QUANTITY='U-VELOCITY', XYZ=3.9,0.1,0.6 /
&TAIL /
