&HEAD CHID='leaf_devc', TITLE='Simple demonstration case.'  / 

&MESH IJK=36,24,24, XB=0.0,3.6,0.0,2.4,0.0,2.4 / 

&TIME T_END=0.6 /
&RADI RADIATION=.FALSE. /

&REAC FUEL='PROPANE', SOOT_YIELD=0.01 /  

&SURF ID='BURNER', HRRPUA=1000., COLOR='RED' /

&OBST XB=0.0,0.4,1.0,1.4,0.0,0.2 /
&VENT XB=0.0,0.4,1.0,1.4,0.2,0.2, SURF_ID='BURNER' /

&VENT XB=3.6,3.6,0.8,1.6,0.0,2.0, SURF_ID='OPEN' / 



&AMR BLOCKING_FACTOR=2 /


&DUMP MASS_FILE=.TRUE., DT_MASS=0.01, DT_HRR=0.01, DT_DEVC=0.01 /

&DEVC ID='VOL', QUANTITY='DENSITY', SPATIAL_STATISTIC='VOLUME', XB=0.0,3.6,0.0,2.4,0.0,2.4 /
&DEVC ID='MASS', QUANTITY='DENSITY', SPATIAL_STATISTIC='VOLUME INTEGRAL', XB=0.0,3.6,0.0,2.4,0.0,2.4 /
&DEVC ID='TMAX', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MAX', XB=0.0,3.6,0.0,2.4,0.0,2.4 /
&DEVC ID='TVMEAN', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='VOLUME MEAN', XB=0.0,3.6,0.0,2.4,0.0,2.4 /
&DEVC ID='NCELL', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='SUM', XB=0.0,3.6,0.0,2.4,0.0,2.4 /
&DEVC ID='T_PT', QUANTITY='TEMPERATURE', XYZ=0.2,1.2,0.5 /
&DEVC ID='RHO_PT', QUANTITY='DENSITY', XYZ=0.2,1.2,0.5 /

&DEVC ID='T_P2', QUANTITY='TEMPERATURE', XYZ=0.21,1.23,0.23 /
&DEVC ID='TMAXB', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MAX', XB=0.0,0.8,0.8,1.6,0.2,0.9 /
&DEVC ID='TMINB', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MIN', XB=0.0,0.8,0.8,1.6,0.2,0.9 /
&DEVC ID='VELB', QUANTITY='W-VELOCITY', SPATIAL_STATISTIC='MAX', XB=0.0,0.8,0.8,1.6,0.2,0.9 /

&TAIL /
