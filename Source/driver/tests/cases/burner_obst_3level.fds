&HEAD CHID='simple_test', TITLE='Simple demonstration case.'  / 

&MESH IJK=36,24,24, XB=0.0,3.6,0.0,2.4,0.0,2.4 / 

&RADI RADIATION=.FALSE. /
&TIME T_END=5.0 /  

&SPEC ID='PROPANE' /  

&SURF ID='BURNER', MASS_FLUX(1)=0.02, SPEC_ID(1)='PROPANE', COLOR='RED' /

&OBST XB=0.0,0.4,1.0,1.4,0.0,0.2 /
&VENT XB=0.0,0.4,1.0,1.4,0.2,0.2, SURF_ID='BURNER' /

&VENT XB=3.6,3.6,0.8,1.6,0.0,2.0, SURF_ID='OPEN' / 

&BNDF QUANTITY='GAUGE HEAT FLUX' / 

&SLCF PBY=1.2, QUANTITY='TEMPERATURE', VECTOR=.TRUE. /


&DEVC ID='qr_floor', XYZ=1.8,1.2,0.0, IOR=3, QUANTITY='RADIATIVE HEAT FLUX' /
&DEVC ID='qr_ceil', XYZ=0.3,1.2,2.4, IOR=-3, QUANTITY='RADIATIVE HEAT FLUX' /
&DEVC ID='qr_wall', XYZ=0.0,0.6,1.2, IOR=1, QUANTITY='RADIATIVE HEAT FLUX' /
&DEVC ID='hf_ceil', XYZ=0.3,1.2,2.4, IOR=-3, QUANTITY='GAUGE HEAT FLUX' /
&DEVC ID='cf_ceil', XYZ=0.3,1.2,2.4, IOR=-3, QUANTITY='CONVECTIVE HEAT FLUX' /
&DEVC ID='tf_ceil', XYZ=0.3,1.2,2.4, IOR=-3, QUANTITY='TOTAL HEAT FLUX' /
&DEVC ID='wt_ceil', XYZ=0.3,1.2,2.4, IOR=-3, QUANTITY='WALL TEMPERATURE' /
&DEVC ID='htc_ceil', XYZ=0.3,1.2,2.4, IOR=-3, QUANTITY='HEAT TRANSFER COEFFICIENT' /
&DEVC ID='rf_ceil', XYZ=0.3,1.2,2.4, IOR=-3, QUANTITY='RADIATIVE HEAT FLUX' /
&DEVC ID='cf_wall', XYZ=0.0,1.2,1.2, IOR=1, QUANTITY='CONVECTIVE HEAT FLUX' /
&DEVC ID='cf_ceil_out', XYZ=3.0,1.2,2.4, IOR=-3, QUANTITY='CONVECTIVE HEAT FLUX' /
&DEVC ID='QR_int', XB=0.0,3.6,0.0,2.4,0.0,2.4, QUANTITY='RADIATION LOSS', SPATIAL_STATISTIC='VOLUME INTEGRAL' /
&DEVC ID='QR_max', XB=0.0,3.6,0.0,2.4,0.0,2.4, QUANTITY='RADIATION LOSS', SPATIAL_STATISTIC='MIN' /
&DEVC ID='U_mean', XB=0.0,3.6,0.0,2.4,0.0,2.4, QUANTITY='INTEGRATED INTENSITY', SPATIAL_STATISTIC='MEAN' /
&DEVC ID='T_max', XB=0.0,3.6,0.0,2.4,0.0,2.4, QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MAX' /
&AMR BLOCKING_FACTOR=4 /
&TAIL /
