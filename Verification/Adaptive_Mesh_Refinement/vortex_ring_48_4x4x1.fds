! Cold-flow vortex ring in a 1 m box, 48^3 cells on 16 meshes (4x4x1), viscosity 1e-3 (Re 800). Input of the long run.
! Boundaries: x and y sides PERIODIC, floor (z=0) INERT no-slip wall, top (z=1) MIRROR.
! Initial velocity: Rosenhead vortex ring (circulation -0.8, ring radius 0.3, core radius 0.2, centre z=0.6), moving down;
! read from the &CSVF UVW file (PERIODIC_TEST=2 only switches on that loader).

&HEAD CHID='vortex_ring_48_4x4x1', TITLE='3-D vortex ring, Re 800, 48^3, 16 meshes' /

&MESH IJK=12,12,48, XB=0,0.25,0,0.25,0,1, MPI_PROCESS=0 /
&MESH IJK=12,12,48, XB=0.25,0.5,0,0.25,0,1, MPI_PROCESS=0 /
&MESH IJK=12,12,48, XB=0.5,0.75,0,0.25,0,1, MPI_PROCESS=0 /
&MESH IJK=12,12,48, XB=0.75,1,0,0.25,0,1, MPI_PROCESS=0 /
&MESH IJK=12,12,48, XB=0,0.25,0.25,0.5,0,1, MPI_PROCESS=1 /
&MESH IJK=12,12,48, XB=0.25,0.5,0.25,0.5,0,1, MPI_PROCESS=1 /
&MESH IJK=12,12,48, XB=0.5,0.75,0.25,0.5,0,1, MPI_PROCESS=1 /
&MESH IJK=12,12,48, XB=0.75,1,0.25,0.5,0,1, MPI_PROCESS=1 /
&MESH IJK=12,12,48, XB=0,0.25,0.5,0.75,0,1, MPI_PROCESS=2 /
&MESH IJK=12,12,48, XB=0.25,0.5,0.5,0.75,0,1, MPI_PROCESS=2 /
&MESH IJK=12,12,48, XB=0.5,0.75,0.5,0.75,0,1, MPI_PROCESS=2 /
&MESH IJK=12,12,48, XB=0.75,1,0.5,0.75,0,1, MPI_PROCESS=2 /
&MESH IJK=12,12,48, XB=0,0.25,0.75,1,0,1, MPI_PROCESS=3 /
&MESH IJK=12,12,48, XB=0.25,0.5,0.75,1,0,1, MPI_PROCESS=3 /
&MESH IJK=12,12,48, XB=0.5,0.75,0.75,1,0,1, MPI_PROCESS=3 /
&MESH IJK=12,12,48, XB=0.75,1,0.75,1,0,1, MPI_PROCESS=3 /

&TIME T_END=5.0 /

&MISC SIMULATION_MODE='DNS', STRATIFICATION=.FALSE., NOISE=.FALSE., CFL_MAX=0.25,
      PERIODIC_TEST=2, UVW_FILE='vortex_ring_48_4x4x1_uvw_m1.csv' /

&CSVF UVWFILE='vortex_ring_48_4x4x1_uvw_m1.csv' /

&PRES VELOCITY_TOLERANCE=1.E-6, MAX_PRESSURE_ITERATIONS=100 /

&RADI RADIATION=.FALSE. /

&SPEC ID='BACKGROUND', BACKGROUND=.TRUE., MW=28.0, VISCOSITY=1.0E-03, DIFFUSIVITY=1.0E-03, SPECIFIC_HEAT=1.0 /

&VENT PBX=0, SURF_ID='PERIODIC' /
&VENT PBX=1, SURF_ID='PERIODIC' /
&VENT PBY=0, SURF_ID='PERIODIC' /
&VENT PBY=1, SURF_ID='PERIODIC' /
&VENT PBZ=0, SURF_ID='INERT' /
&VENT PBZ=1, SURF_ID='MIRROR' /
&TAIL /
