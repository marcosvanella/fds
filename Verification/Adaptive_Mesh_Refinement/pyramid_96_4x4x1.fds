! Vortex ring (Re 800, viscosity 1e-3) hitting a three-step pyramid of OBSTs on the floor; 1 m box, 96^3 cells on 16 meshes (4x4x1).
! Plain-FDS reference for the pyramid case. Pyramid edges on odd 1/96 grid lines, XB nudged outward by 1e-6.
! Boundaries: x and y sides PERIODIC, floor (z=0) INERT no-slip wall, top (z=1) MIRROR.
! Initial velocity: Rosenhead vortex ring (circulation -0.8, ring radius 0.3, core radius 0.2, centre z=0.6), moving down;
! read from the &CSVF UVW file (PERIODIC_TEST=2 only switches on that loader).

&HEAD CHID='pyramid_96_4x4x1', TITLE='Vortex ring over a 3-step pyramid, 96^3, 16 meshes (plain FDS reference)' /

&MESH IJK=24,24,96, XB=0,0.25,0,0.25,0,1, MPI_PROCESS=0 /
&MESH IJK=24,24,96, XB=0.25,0.5,0,0.25,0,1, MPI_PROCESS=1 /
&MESH IJK=24,24,96, XB=0.5,0.75,0,0.25,0,1, MPI_PROCESS=2 /
&MESH IJK=24,24,96, XB=0.75,1,0,0.25,0,1, MPI_PROCESS=3 /
&MESH IJK=24,24,96, XB=0,0.25,0.25,0.5,0,1, MPI_PROCESS=4 /
&MESH IJK=24,24,96, XB=0.25,0.5,0.25,0.5,0,1, MPI_PROCESS=5 /
&MESH IJK=24,24,96, XB=0.5,0.75,0.25,0.5,0,1, MPI_PROCESS=6 /
&MESH IJK=24,24,96, XB=0.75,1,0.25,0.5,0,1, MPI_PROCESS=7 /
&MESH IJK=24,24,96, XB=0,0.25,0.5,0.75,0,1, MPI_PROCESS=8 /
&MESH IJK=24,24,96, XB=0.25,0.5,0.5,0.75,0,1, MPI_PROCESS=9 /
&MESH IJK=24,24,96, XB=0.5,0.75,0.5,0.75,0,1, MPI_PROCESS=10 /
&MESH IJK=24,24,96, XB=0.75,1,0.5,0.75,0,1, MPI_PROCESS=11 /
&MESH IJK=24,24,96, XB=0,0.25,0.75,1,0,1, MPI_PROCESS=12 /
&MESH IJK=24,24,96, XB=0.25,0.5,0.75,1,0,1, MPI_PROCESS=13 /
&MESH IJK=24,24,96, XB=0.5,0.75,0.75,1,0,1, MPI_PROCESS=14 /
&MESH IJK=24,24,96, XB=0.75,1,0.75,1,0,1, MPI_PROCESS=15 /

&TIME T_END=6.0 /

&MISC SIMULATION_MODE='DNS', STRATIFICATION=.FALSE., NOISE=.FALSE., CFL_MAX=0.25,
      PERIODIC_TEST=2, UVW_FILE='vortex_ring_96_4x4x1_uvw_m1.csv' /

&CSVF UVWFILE='vortex_ring_96_4x4x1_uvw_m1.csv' /

! UGLMAT is kept on purpose: this file is the plain-FDS reference, and the default FFT solver hits the 100-iteration cap every step here.
&PRES SOLVER='UGLMAT', VELOCITY_TOLERANCE=1.E-6, MAX_PRESSURE_ITERATIONS=100 /

&RADI RADIATION=.FALSE. /

&SPEC ID='BACKGROUND', BACKGROUND=.TRUE., MW=28.0, VISCOSITY=1.0E-03, DIFFUSIVITY=1.0E-03, SPECIFIC_HEAT=1.0 /

&VENT PBX=0, SURF_ID='PERIODIC' /
&VENT PBX=1, SURF_ID='PERIODIC' /
&VENT PBY=0, SURF_ID='PERIODIC' /
&VENT PBY=1, SURF_ID='PERIODIC' /
&VENT PBZ=0, SURF_ID='INERT' /
&VENT PBZ=1, SURF_ID='MIRROR' /
&OBST ID='PYR_STEP1', XB=0.1770823333,0.8229176667,0.1770823333,0.8229176667,-0.0000010000,0.0520843333 /  ! x,y in [17/96,79/96], z in [0,5/96], nudged out 1e-6
&OBST ID='PYR_STEP2', XB=0.2812490000,0.7187510000,0.2812490000,0.7187510000,-0.0000010000,0.1145843333 /  ! x,y in [27/96,69/96], z in [0,11/96], nudged out 1e-6
&OBST ID='PYR_STEP3', XB=0.3854156667,0.6145843333,0.3854156667,0.6145843333,-0.0000010000,0.1770843333 /  ! x,y in [37/96,59/96], z in [0,17/96], nudged out 1e-6

&DUMP DT_SLCF=0.04, DT_DEVC=0.04 /
&SLCF PBY=0.5, QUANTITY='DENSITY' /
&SLCF PBY=0.5, QUANTITY='U-VELOCITY' /
&SLCF PBY=0.5, QUANTITY='V-VELOCITY' /
&SLCF PBY=0.5, QUANTITY='W-VELOCITY' /
&SLCF PBY=0.5, QUANTITY='VORTICITY Y' /
&SLCF PBX=0.5, QUANTITY='W-VELOCITY' /
&SLCF PBX=0.5, QUANTITY='VORTICITY X' /
&SLCF XB=0,1,0,1,0,1, QUANTITY='VORTICITY Y' /  ! 3-D, for overlays at any y

&TAIL /
