&DEVC XB=6.46667,3.13333,2.23333,5.56667,5.23333,3.56667, POINTS=51, QUANTITY='U-VELOCITY', ID='U_d200_r2', STATISTICS_START=10. /
&DEVC XB=6.46667,3.13333,2.23333,5.56667,5.23333,3.56667, POINTS=51, QUANTITY='V-VELOCITY', ID='V_d200_r2', STATISTICS_START=10. /
&DEVC XB=6.46667,3.13333,2.23333,5.56667,5.23333,3.56667, POINTS=51, QUANTITY='W-VELOCITY', ID='W_d200_r2', STATISTICS_START=10. /
&DEVC XB=6.53333,3.20000,2.36667,5.70000,5.36667,3.70000, POINTS=51, QUANTITY='U-VELOCITY', ID='U_d200_r3', STATISTICS_START=10. /
&DEVC XB=6.53333,3.20000,2.36667,5.70000,5.36667,3.70000, POINTS=51, QUANTITY='V-VELOCITY', ID='V_d200_r3', STATISTICS_START=10. /
&DEVC XB=6.53333,3.20000,2.36667,5.70000,5.36667,3.70000, POINTS=51, QUANTITY='W-VELOCITY', ID='W_d200_r3', STATISTICS_START=10. /
&SLCF QUANTITY='VELOCITY', VECTOR=.TRUE., PBY=5.0, CELL_CENTERED=.TRUE. /
&SLCF QUANTITY='VELOCITY', VECTOR=.TRUE., PBZ=3.0, CELL_CENTERED=.TRUE. /

&TAIL /
