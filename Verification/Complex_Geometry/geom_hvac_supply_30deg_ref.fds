&HEAD CHID='geom_hvac_supply_30deg_ref', TITLE='Complex Geometry: supply box turned 30 deg about the vertical axis, GEOM, reference with the previous cut-cell momentum.' /

# Room 10 m x 10 m x 6 m with 0.2 m cells. A box 3.0 m x 2.4 m x 0.4 m (centre 7.1, 5.0, 2.0 m) blows air
# through its small -x face of its own frame: 5 m3/s through 0.96 m2. The air leaves through an open vent in the y=10 m wall.
# GEOM box turned by 30 degrees about the vertical axis through its center (MOVE).
# Line devices measure the time-averaged velocity (t > 10 s) on three planes 0.5, 1 and 2 m from the center of the supply
# face, normal to the face; the lines are 5 m long along the long side of the face, in four rows 0.2 m apart (rows -0.3 to 0.3 m
# along the short side). Utilities/Python/scripts/geom_hvac_supply_jet.py reads the file geom_hvac_supply_30deg_ref_line.csv.
&MESH ID='Mesh01', IJK=50,50,30, XB=0.0,10.0,0.0,10.0,0.0,6.0 /
&TIME T_END=30. /
&MISC RND_SEED=101 /
&DUMP DT_DEVC=0.1, DT_SLCF=1. /
&PRES SOLVER='UGLMAT' /

&SURF ID='SUPPLY', VEL=-5.208333, COLOR='BLUE' /

&MOVE ID='MV', AXIS=0,0,1, ROTATION_ANGLE=30., X0=7.1,Y0=5.0,Z0=2.0 /
&GEOM ID='Box', XB=5.6000,8.6000,3.8000,6.2000,1.8000,2.2000, SURF_ID6='SUPPLY','INERT','INERT','INERT','INERT','INERT', MOVE_ID='MV' /

&VENT ID='Vent', SURF_ID='OPEN', XB=8.2,10.0,10.0,10.0,2.0,3.0 /

&DEVC XB=6.61795,4.11795,1.83494,6.16506,1.70000,1.70000, POINTS=51, QUANTITY='U-VELOCITY', ID='U_d050_r0', STATISTICS_START=10. /
&DEVC XB=6.61795,4.11795,1.83494,6.16506,1.70000,1.70000, POINTS=51, QUANTITY='V-VELOCITY', ID='V_d050_r0', STATISTICS_START=10. /
&DEVC XB=6.61795,4.11795,1.83494,6.16506,1.70000,1.70000, POINTS=51, QUANTITY='W-VELOCITY', ID='W_d050_r0', STATISTICS_START=10. /
&DEVC XB=6.61795,4.11795,1.83494,6.16506,1.90000,1.90000, POINTS=51, QUANTITY='U-VELOCITY', ID='U_d050_r1', STATISTICS_START=10. /
&DEVC XB=6.61795,4.11795,1.83494,6.16506,1.90000,1.90000, POINTS=51, QUANTITY='V-VELOCITY', ID='V_d050_r1', STATISTICS_START=10. /
&DEVC XB=6.61795,4.11795,1.83494,6.16506,1.90000,1.90000, POINTS=51, QUANTITY='W-VELOCITY', ID='W_d050_r1', STATISTICS_START=10. /
&DEVC XB=6.61795,4.11795,1.83494,6.16506,2.10000,2.10000, POINTS=51, QUANTITY='U-VELOCITY', ID='U_d050_r2', STATISTICS_START=10. /
&DEVC XB=6.61795,4.11795,1.83494,6.16506,2.10000,2.10000, POINTS=51, QUANTITY='V-VELOCITY', ID='V_d050_r2', STATISTICS_START=10. /
&DEVC XB=6.61795,4.11795,1.83494,6.16506,2.10000,2.10000, POINTS=51, QUANTITY='W-VELOCITY', ID='W_d050_r2', STATISTICS_START=10. /
&DEVC XB=6.61795,4.11795,1.83494,6.16506,2.30000,2.30000, POINTS=51, QUANTITY='U-VELOCITY', ID='U_d050_r3', STATISTICS_START=10. /
&DEVC XB=6.61795,4.11795,1.83494,6.16506,2.30000,2.30000, POINTS=51, QUANTITY='V-VELOCITY', ID='V_d050_r3', STATISTICS_START=10. /
&DEVC XB=6.61795,4.11795,1.83494,6.16506,2.30000,2.30000, POINTS=51, QUANTITY='W-VELOCITY', ID='W_d050_r3', STATISTICS_START=10. /
&DEVC XB=6.18494,3.68494,1.58494,5.91506,1.70000,1.70000, POINTS=51, QUANTITY='U-VELOCITY', ID='U_d100_r0', STATISTICS_START=10. /
&DEVC XB=6.18494,3.68494,1.58494,5.91506,1.70000,1.70000, POINTS=51, QUANTITY='V-VELOCITY', ID='V_d100_r0', STATISTICS_START=10. /
&DEVC XB=6.18494,3.68494,1.58494,5.91506,1.70000,1.70000, POINTS=51, QUANTITY='W-VELOCITY', ID='W_d100_r0', STATISTICS_START=10. /
