&DEVC XB=6.18494,3.68494,1.58494,5.91506,2.10000,2.10000, POINTS=51, QUANTITY='W-VELOCITY', ID='W_d100_r2', STATISTICS_START=10. /
&DEVC XB=6.18494,3.68494,1.58494,5.91506,2.30000,2.30000, POINTS=51, QUANTITY='U-VELOCITY', ID='U_d100_r3', STATISTICS_START=10. /
&DEVC XB=6.18494,3.68494,1.58494,5.91506,2.30000,2.30000, POINTS=51, QUANTITY='V-VELOCITY', ID='V_d100_r3', STATISTICS_START=10. /
&DEVC XB=6.18494,3.68494,1.58494,5.91506,2.30000,2.30000, POINTS=51, QUANTITY='W-VELOCITY', ID='W_d100_r3', STATISTICS_START=10. /
&DEVC XB=5.31891,2.81891,1.08494,5.41506,1.70000,1.70000, POINTS=51, QUANTITY='U-VELOCITY', ID='U_d200_r0', STATISTICS_START=10. /
&DEVC XB=5.31891,2.81891,1.08494,5.41506,1.70000,1.70000, POINTS=51, QUANTITY='V-VELOCITY', ID='V_d200_r0', STATISTICS_START=10. /
&DEVC XB=5.31891,2.81891,1.08494,5.41506,1.70000,1.70000, POINTS=51, QUANTITY='W-VELOCITY', ID='W_d200_r0', STATISTICS_START=10. /
&DEVC XB=5.31891,2.81891,1.08494,5.41506,1.90000,1.90000, POINTS=51, QUANTITY='U-VELOCITY', ID='U_d200_r1', STATISTICS_START=10. /
