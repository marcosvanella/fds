&HEAD CHID='geom_burner_3d_stair', TITLE='Complex Geometry: burner turned 60 deg about the axis (-1,1,1), stair-stepped OBST.' /

# A 0.6 m x 0.6 m x 0.1 m burner of 360 kW (HRRPUA 1000 kW/m2 on its top face) floats in open air, propane, 0.05 m cells.
# Stair-stepped OBST version of the turned burner: the 288 grid cells whose center lies in the turned burner are OBSTs, the exposed faces nearest to its top plane burn (234 faces, 0.585 m2, HRRPUA scaled to 360 kW); gravity turned with it (GVEC).
# 18 points on the burner axis (from 0.075 m above the burner top face, up to 1.925 m) give the mean temperature and velocity (t > 5 s), and
# a 3D slice of the heat release rate per unit volume gives the flame height. Utilities/Python/scripts/geom_burner_plume.py
# reads geom_burner_3d_stair_line.csv and the slice file.
&MESH XB=-1.050,-0.150,-0.950,0.150,-0.950,0.700, IJK=18,22,33, MULT_ID='M' /
&MULT ID='M', DX=0.9, DY=1.1, DZ=1.65, I_UPPER=2, J_UPPER=2, K_UPPER=1 /

&MISC RND_SEED=101, STRATIFICATION=.FALSE., GVEC=-3.268883,-6.537767,-6.537767 /
&TIME T_END=15. /
&DUMP DT_DEVC=1., DT_SLCF=0.5, SMOKE3D=.FALSE. /
&PRES SOLVER='UGLMAT' /

&REAC FUEL='PROPANE', SOOT_YIELD=0.02 /

&SURF ID='FIRE', HRRPUA=615.3846, COLOR='RED' /

&OBST XB=-0.40,-0.35,0.05,0.10,0.05,0.10, SURF_ID6='INERT','INERT','INERT','INERT','INERT','INERT' /
&OBST XB=-0.40,-0.35,0.10,0.15,0.10,0.15, SURF_ID6='INERT','FIRE','INERT','INERT','INERT','FIRE' /
&OBST XB=-0.35,-0.30,0.00,0.05,0.05,0.10, SURF_ID6='INERT','INERT','INERT','INERT','INERT','INERT' /
