&HEAD CHID='geom_couette_3d_N42', TITLE='Complex Geometry: exact flow 32, spherical Couette (Stokes) flow between concentric GEOM spheres, inner sphere turning, N=42.' /

# PERIODIC_TEST=32: initial velocity and wall velocity from the exact solution; the face velocities and their exact values are
# written to geom_couette_3d_N42_mms_m1_s<step>.csv at MMS_TIMER (see Utilities/Python/scripts/geom_exact_flows_error.py).
&MESH IJK=21,21,21, XB=-1.05,0.,-1.05,0.,-1.05,0., MULT_ID='MESH' /
&MULT ID='MESH', DX=1.05, DY=1.05, DZ=1.05, I_UPPER=1, J_UPPER=1, K_UPPER=1 /
&TIME T_END=40 /
&MISC PERIODIC_TEST=32, SIMULATION_MODE='DNS', NOISE=.FALSE., STRATIFICATION=.FALSE., GVEC=0.,0.,0., TMPA=20., CC_O3E=.TRUE. /
&PRES SOLVER='UGLMAT' /
&RADI RADIATION=.FALSE. /
&DUMP MMS_TIMER=39.999, NFRAMES=10, DIAGNOSTICS_INTERVAL=1000 /

&SPEC ID='GAS', BACKGROUND=.TRUE., MW=28.97, VISCOSITY=0.00602158108 /
&SURF ID='IN',  COLOR='RED' /
&SURF ID='OUT', COLOR='BLUE' /

&GEOM ID='INNER', SURF_ID='IN', SPHERE_ORIGIN=0.013,0.027,-0.019, SPHERE_RADIUS=0.5, N_LEVELS=3 /
&GEOM ID='OUTER', SURF_ID='OUT', BINARY_FILE='geom_sphere_cavity.bin' /

&TAIL /
