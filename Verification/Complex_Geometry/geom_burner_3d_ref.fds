&HEAD CHID='geom_burner_3d_ref', TITLE='Complex Geometry: burner turned 60 deg about the axis (-1,1,1), GEOM, reference with the previous cut-cell momentum.' /

# A 0.6 m x 0.6 m x 0.1 m burner of 360 kW (HRRPUA 1000 kW/m2 on its top face) floats in open air, propane, 0.05 m cells.
# GEOM burner turned by 60 degrees about the axis (-1,1,1) through its center (MOVE); gravity turned with it (GVEC), so the plume rises along (1,2,2)/3.
# 18 points on the burner axis (from 0.075 m above the burner top face, up to 1.925 m) give the mean temperature and velocity (t > 5 s), and
# a 3D slice of the heat release rate per unit volume gives the flame height. Utilities/Python/scripts/geom_burner_plume.py
# reads geom_burner_3d_ref_line.csv and the slice file.
&MESH XB=-1.050,-0.150,-0.950,0.150,-0.950,0.700, IJK=18,22,33, MULT_ID='M' /
&MULT ID='M', DX=0.9, DY=1.1, DZ=1.65, I_UPPER=2, J_UPPER=2, K_UPPER=1 /

&MISC RND_SEED=101, STRATIFICATION=.FALSE., GVEC=-3.268883,-6.537767,-6.537767 /
&TIME T_END=15. /
&DUMP DT_DEVC=1., DT_SLCF=0.5, SMOKE3D=.FALSE. /
&PRES SOLVER='UGLMAT' /

&REAC FUEL='PROPANE', SOOT_YIELD=0.02 /

&SURF ID='FIRE', HRRPUA=1000, COLOR='RED' /

&MOVE ID='MV', AXIS=-1,1,1, ROTATION_ANGLE=60., X0=0.,Y0=0.,Z0=0. /
&GEOM ID='BURNER', XB=-0.3,0.3,-0.3,0.3,-0.05,0.05, SURF_IDS='FIRE','INERT','INERT', MOVE_ID='MV' /

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMIN', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /

&DEVC XB=0.02500,0.64167,0.05000,1.28333,0.05000,1.28333, POINTS=18, QUANTITY='TEMPERATURE', ID='T', STATISTICS_START=5. /
&DEVC XB=0.02500,0.64167,0.05000,1.28333,0.05000,1.28333, POINTS=18, QUANTITY='U-VELOCITY', ID='U', STATISTICS_START=5. /
&DEVC XB=0.02500,0.64167,0.05000,1.28333,0.05000,1.28333, POINTS=18, QUANTITY='V-VELOCITY', ID='V', STATISTICS_START=5. /
&DEVC XB=0.02500,0.64167,0.05000,1.28333,0.05000,1.28333, POINTS=18, QUANTITY='W-VELOCITY', ID='W', STATISTICS_START=5. /

&SLCF QUANTITY='HRRPUV', XB=-0.65,1.4,-0.65,2.15,-0.65,2.15, CELL_CENTERED=.TRUE. /

&TAIL /
